---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const [categories, publishers, games] = await Promise.all([
  getAllCategories(getDatabase()),
  getAllPublishers(getDatabase()),
  getAllGames(getDatabase()),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-900/60 p-5 shadow-lg">
      <div class="flex flex-col gap-4 md:flex-row md:items-end">
        <div class="flex-1">
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by category</label>
          <select
            id="category-filter"
            data-testid="category-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Filter games by category"
          >
            <option value="all">All categories</option>
            {categories.map((category) => (
              <option value={String(category.id)}>{category.name}</option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by publisher</label>
          <select
            id="publisher-filter"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            aria-label="Filter games by publisher"
          >
            <option value="all">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)}>{publisher.name}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="hidden rounded-xl border border-slate-700 bg-slate-900/60 p-6 text-slate-300" data-testid="empty-games-state">
            No games match the selected filters.
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-category-id={game.category?.id ?? 'none'}
                data-publisher-id={game.publisher?.id ?? 'none'}
                data-testid="game-card-wrapper"
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryFilter = document.querySelector('[data-testid="category-filter"]') as HTMLSelectElement | null;
    const publisherFilter = document.querySelector('[data-testid="publisher-filter"]') as HTMLSelectElement | null;
    const gamesGrid = document.querySelector('[data-testid="games-grid"]') as HTMLDivElement | null;
    const emptyState = document.querySelector('[data-testid="empty-games-state"]') as HTMLDivElement | null;
    const gameCards = () =>
      Array.from(document.querySelectorAll('[data-testid="game-card-wrapper"]')) as HTMLDivElement[];

    function applyGameFilters() {
      if (!categoryFilter || !publisherFilter || !gamesGrid) {
        return;
      }

      const selectedCategory = categoryFilter.value;
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      gameCards().forEach((card) => {
        const categoryId = card.getAttribute('data-category-id');
        const publisherId = card.getAttribute('data-publisher-id');
        const matchesCategory = selectedCategory === 'all' || categoryId === selectedCategory;
        const matchesPublisher = selectedPublisher === 'all' || publisherId === selectedPublisher;
        const isVisible = matchesCategory && matchesPublisher;

        card.style.display = isVisible ? '' : 'none';

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount !== 0);
      }

      gamesGrid.classList.toggle('hidden', visibleCount === 0);
    }

    categoryFilter?.addEventListener('change', applyGameFilters);
    publisherFilter?.addEventListener('change', applyGameFilters);
    applyGameFilters();
  </script>
</Layout>
